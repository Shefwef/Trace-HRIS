# Copy to .env.local and fill in real values. Never commit .env.local.

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Where Clerk sends signed-out users and where to land them afterwards.
# The sign-in route lives at src/app/(auth)/sign-in/[[...sign-in]].
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/

# Neon Postgres — https://console.neon.tech
# DATABASE_URL is the pooled connection (host contains "-pooler").
# DIRECT_URL is the direct connection (same string with "-pooler" removed from host).
DATABASE_URL=postgresql://neondb_owner:password@ep-xxxx-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://neondb_owner:password@ep-xxxx.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_...

# Clerk webhook signing secret (Phase 6+) — https://dashboard.clerk.com → Webhooks
# Without this /api/webhooks/clerk returns 501 and you have to keep Clerk + HRIS in sync manually.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Gemini API key — powers the in-app "Ask HRIS" chatbot (Google AI Studio free tier).
# https://aistudio.google.com/apikey
# Without this /api/chat returns 501 and the help panel shows a "not configured" message.
GEMINI_API_KEY=AIza...

# App URL — used in email links, defaults to localhost in dev
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Geoapify API key — powers place search AND the map on the "Change work
# location" modal. Both come from this one key.
#
# Get it: https://myprojects.geoapify.com -> sign up -> create a project ->
# API Keys. No credit card required. Free tier is 3,000 credits/day, where a
# search costs 1 credit and a map tile 0.25, so a map view is ~2-3 credits.
# For Trace's headcount that is not a constraint.
#
# Before going live, open the key in MyProjects and set "Allowed origins" to
# your domains. This key is inlined into the browser bundle by design — MapLibre
# fetches tiles straight from the page — so origin restriction, not secrecy, is
# what protects the quota.
#
# Free-tier terms require attribution (Geoapify + OpenStreetMap + OpenMapTiles).
# It is rendered automatically because the map loads from Geoapify's style.json;
# do not hide the attribution control.
#
# Optional: without it the modal falls back to typing the destination by hand,
# and every other part of work-location tracking works unchanged.
NEXT_PUBLIC_GEOAPIFY_API_KEY=

# Basemap style. Defaults to "positron" — pale and low-ink, so the pin is the
# loudest thing on the map, and it carries fewer label layers than the
# osm-bright family. Any Geoapify vector style id works: osm-bright-smooth,
# osm-liberty, klokantech-basic, toner-grey, dark-matter, positron-blue.
# NEXT_PUBLIC_GEOAPIFY_MAP_STYLE=positron

# Office timezone. Every "which day is it" decision (attendance day keys,
# weekend detection, report ranges) resolves through this. Defaults to
# Asia/Dhaka; only change it if Trace opens an office in another zone.
APP_TIMEZONE=Asia/Dhaka

# Office address and map anchor. All three are optional — src/lib/office.ts
# already carries Trace's Mohakhali New DOHS address as its default. Set them
# only if the office moves, or to fine-tune the pin the map opens on. The
# coordinates bias Places search and centre the initial view; nothing recorded
# depends on them, since an off-site pin's coordinates come from the place the
# employee picked.
# NEXT_PUBLIC_OFFICE_ADDRESS=Level 2, Plot 285, Road 19/C, Mohakhali New DOHS, Dhaka-1206, Bangladesh
# NEXT_PUBLIC_OFFICE_LAT=23.7815
# NEXT_PUBLIC_OFFICE_LNG=90.4001
